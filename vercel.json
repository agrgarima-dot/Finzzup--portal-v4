{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/zoho-refresh",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/monthly-reminder",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/weekly-alerts",
      "schedule": "0 7 * * 1"
    }
  ]
}
